{
  "info": {
    "_postman_id": "2f9949f1-5d56-4f2f-8ff6-f8d875915282",
    "name": "To-Do List Microsservicos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Laravel - Listar tarefas",
      "request": {
        "method": "GET",
        "url": "{{laravel_base}}/todos"
      }
    },
    {
      "name": "Laravel - Criar tarefa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Tarefa via Postman\",\n  \"description\": \"Criada para teste\"\n}"
        },
        "url": "{{laravel_base}}/todos"
      }
    },
    {
      "name": "Laravel - Alternar tarefa",
      "request": {
        "method": "PATCH",
        "url": "{{laravel_base}}/todos/{{todo_id}}/toggle"
      }
    },
    {
      "name": "Laravel - Excluir tarefa",
      "request": {
        "method": "DELETE",
        "url": "{{laravel_base}}/todos/{{todo_id}}"
      }
    },
    {
      "name": "Express - Criar log",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"create\",\n  \"todo_id\": 1,\n  \"message\": \"Log criado via Postman\"\n}"
        },
        "url": "{{express_base}}/logs"
      }
    },
    {
      "name": "Express - Listar logs",
      "request": {
        "method": "GET",
        "url": "{{express_base}}/logs"
      }
    },
    {
      "name": "FastAPI - Estatisticas",
      "request": {
        "method": "GET",
        "url": "{{fastapi_base}}/stats"
      }
    }
  ],
  "variable": [
    {
      "key": "laravel_base",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "express_base",
      "value": "http://localhost:3001/api"
    },
    {
      "key": "fastapi_base",
      "value": "http://localhost:8001/api"
    },
    {
      "key": "todo_id",
      "value": "1"
    }
  ]
}
